{
  "name": "cardano-actions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cardano Actions — an open specification and TypeScript SDK that turns a shareable URL into a signable Cardano transaction",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "vitest",
    "coverage": "turbo run test -- --coverage",
    "lint": "turbo run lint //#lint:root //#format:check",
    "lint:root": "eslint .",
    "lint:fix": "turbo run lint //#lint:root -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf .turbo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
