          { "name": "amount", "label": "Amount", "type": "number", "min": 1, "max": 500, "required": true },
          {
            "name": "token",
            "label": "Token",
            "type": "select",
            "required": true,
            "options": [
              { "label": "USDM", "value": "usdm" },
              { "label": "USDCx", "value": "usdcx" }
