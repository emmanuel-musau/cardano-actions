# Registry and publish settings only.
#
# Since pnpm 10, pnpm's own behaviour settings (engineStrict,
# linkWorkspacePackages, …) are read from pnpm-workspace.yaml — the equivalent
# .npmrc keys are silently ignored. Put those there, not here.
#
# Pinning the registry keeps a clone from inheriting a mirror configured in a
# contributor's user-level .npmrc.
registry=https://registry.npmjs.org/
